config sms-tool 'global'
	option enabled '1'
	option modem_port '/dev/ttyUSB2'
	option receive_port '/dev/ttyUSB2'
	option send_port '/dev/ttyUSB2'
	option baud_rate '115200'
	option pin ''
	option storage 'ME'
	option view_storage 'ME'
	option poll_interval '30'
	option max_messages '500'
	option delete_after_read '0'
	option log_enabled '1'
	option log_file '/var/log/sms-tool.log'
