'use strict';

let uci = require('uci').cursor();
let fs  = require('fs');

function get_config() {
	return {
		send_port:    uci.get('sms-tool', 'global', 'send_port')    || '/dev/ttyUSB2',
		receive_port: uci.get('sms-tool', 'global', 'receive_port') || '/dev/ttyUSB2',
		baud_rate:    uci.get('sms-tool', 'global', 'baud_rate')    || '115200',
		storage:      uci.get('sms-tool', 'global', 'storage')      || 'SM',
		view_storage: uci.get('sms-tool', 'global', 'view_storage')
		              || uci.get('sms-tool', 'global', 'storage')   || 'SM',
	};
}

function run(args) {
	let fd = fs.popen('/usr/bin/sms_tool ' + args, 'r');
	if (!fd) return '';
	let out = fd.read('all');
	fd.close();
	return out || '';
}

function run_at(port, baud, cmd) {
	let out = run('-d ' + port + ' -b ' + baud + ' at "' + cmd + '"');
	let lines = split(out, '\n');
	let result = [];
	for (let i = 1; i < length(lines); i++) {
		let l = trim(lines[i]);
		if (l != '') push(result, l);
	}
	return join('\n', result);
}

// Point ONLY mem1 (the read/delete pointer) at a storage. Safe for SM/ME/MT.
// This does NOT change where incoming messages are stored (mem3), so browsing
// any inbox never reroutes new SMS.
function set_read_mem(port, baud, storage) {
	run_at(port, baud, 'AT+CPMS=\\"' + storage + '\\"');
}

// Set the incoming-message store: mem1/mem2/mem3 all to one concrete storage.
// MT is NOT a valid store target on essentially all modems (it is a read-only
// aggregate), so callers must use SM or ME. Invalid input falls back to SM.
function set_store(port, baud, storage) {
	if (storage != 'SM' && storage != 'ME') storage = 'SM';
	run_at(port, baud,
		'AT+CPMS=\\"' + storage + '\\",\\"' + storage + '\\",\\"' + storage + '\\"');
	return storage;
}

return {
	'luci.sms-tool': {

		send: {
			args: { number: 'string', message: 'string' },
			call: function(req) {
				if (!req.args.number || !req.args.message)
					return { error: 'number and message required' };
				let c = get_config();
				let out = run('-d ' + c.send_port + ' -b ' + c.baud_rate +
					' send "' + req.args.number + '" "' + req.args.message + '"');
				if (index(out, 'sucessfully') >= 0)
					return { success: true, mr: trim(out) };
				return { error: trim(out) || 'send failed' };
			}
		},

		// Persist which storage the Inbox is *viewing*. Writes uci only; never
		// issues AT+CPMS, so selecting the SIM inbox no longer reroutes incoming
		// messages to the SIM. This is what makes the dropdown "stay put".
		set_view: {
			args: { storage: 'SM' },
			call: function(req) {
				let v = req.args.storage;
				if (v != 'SM' && v != 'ME' && v != 'MT') v = 'SM';
				uci.set('sms-tool', 'global', 'view_storage', v);
				uci.commit('sms-tool');
				return { success: true, view_storage: v };
			}
		},

		// Apply the configured incoming-store (uci 'storage') to the modem now.
		// Called by Settings on Save & Apply and by the init script at boot.
		apply_storage: {
			call: function() {
				let c = get_config();
				let s = set_store(c.receive_port, c.baud_rate, c.storage);
				return { success: true, storage: s };
			}
		},

		// Return persisted state so the Inbox can restore its dropdown.
		get_state: {
			call: function() {
				let c = get_config();
				return { storage: c.storage, view_storage: c.view_storage };
			}
		},

		read: {
			args: { storage: 'SM' },
			call: function(req) {
				let storage = req.args.storage;
				if (storage != 'SM' && storage != 'ME' && storage != 'MT')
					storage = 'SM';
				let c = get_config();

				// "MT" is not reliable as an aggregate — many modems implement it
				// as ME-only, so the SIM messages never appear. Read SM and ME
				// separately and merge, tagging each message with where it truly
				// lives so the UI can badge it and delete can target it correctly.
				let stores = (storage == 'MT') ? [ 'SM', 'ME' ] : [ storage ];
				let messages = [];

				for (let i = 0; i < length(stores); i++) {
					let st = stores[i];
					// sms_tool -s issues `AT+CPMS="<s>"` (mem1 only). Incoming
					// store (mem3) is untouched, so viewing never reroutes SMS.
					let out = run('-d ' + c.receive_port + ' -b ' + c.baud_rate +
						' -s ' + st + ' -j recv');
					let result = null;
					try { result = json(out); } catch(e) {}
					if (!result || !result.msg)
						continue;
					for (let k = 0; k < length(result.msg); k++) {
						let m = result.msg[k];
						push(messages, {
							index:     m.index,
							storage:   st,
							from:      m.sender,
							timestamp: m.timestamp,
							body:      m.content,
							status:    'REC READ'
						});
					}
				}

				return { messages: messages };
			}
		},

		delete: {
			args: { index: 0, storage: 'SM' },
			call: function(req) {
				let c = get_config();
				let p = c.receive_port;
				let b = c.baud_rate;
				let storage = req.args.storage;
				if (storage != 'SM' && storage != 'ME' && storage != 'MT')
					storage = 'SM';
				// Point mem1 at the storage being viewed, then delete. mem3 is
				// left alone so deleting never changes the incoming-store.
				set_read_mem(p, b, storage);
				let out = run_at(p, b, 'AT+CMGD=' + int(req.args.index) + ',0');
				if (index(out, 'ERROR') < 0)
					return { success: true };
				return { error: 'AT+CMGD failed: ' + out };
			}
		},

		storage: {
			call: function() {
				let c = get_config();
				let p = c.receive_port;
				let b = c.baud_rate;
				let sm_out = run('-d ' + p + ' -b ' + b + ' -s SM status');
				let me_out = run('-d ' + p + ' -b ' + b + ' -s ME status');
				let sm_used = 0, sm_total = 0, me_used = 0, me_total = 0;
				let m;
				m = match(sm_out, /used: ([0-9]+), total: ([0-9]+)/);
				if (m) { sm_used = int(m[1]); sm_total = int(m[2]); }
				m = match(me_out, /used: ([0-9]+), total: ([0-9]+)/);
				if (m) { me_used = int(m[1]); me_total = int(m[2]); }
				return {
					sim:   { used: sm_used,  total: sm_total  },
					modem: { used: me_used,  total: me_total  }
				};
			}
		},

		modem_info: {
			call: function() {
				let c = get_config();
				let p = c.receive_port;
				let b = c.baud_rate;
				let manufacturer = run_at(p, b, 'AT+CGMI');
				let model        = run_at(p, b, 'AT+CGMM');
				let imei         = run_at(p, b, 'AT+CGSN');
				let csq_raw      = run_at(p, b, 'AT+CSQ');
				run_at(p, b, 'AT+COPS=3,0');
				let cops_raw     = run_at(p, b, 'AT+COPS?');
				let cpin_raw     = run_at(p, b, 'AT+CPIN?');

				let signal_raw = 99;
				let m = match(csq_raw, /\+CSQ: ([0-9]+)/);
				if (m) signal_raw = int(m[1]);
				let signal_dbm = (signal_raw < 99) ? (-113 + signal_raw * 2) : null;

				let network = '';
				m = match(cops_raw, /\+COPS: [^"]*"([^"]+)"/);
				if (m) network = m[1];

				let sim_status = '';
				m = match(cpin_raw, /\+CPIN: (.+)/);
				if (m) sim_status = trim(m[1]);

				return {
					manufacturer: manufacturer,
					model:        model,
					imei:         imei,
					signal_raw:   signal_raw,
					signal_dbm:   signal_dbm,
					network:      network,
					sim_status:   sim_status
				};
			}
		}
	}
};
